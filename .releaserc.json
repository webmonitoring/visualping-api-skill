{
  "branches": ["develop"],
  "plugins": [
    ["@semantic-release/commit-analyzer", {
      "releaseRules": [
        { "type": "chore", "release": "minor" },
        { "type": "feat", "release": "minor" },
        { "type": "fix", "release": "patch" },
        { "release": "minor" }
      ]
    }],
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "sed -i 's/^version: \"[^\"]*\"/version: \"${nextRelease.version}\"/' SKILL.md && zip visualping-api.skill SKILL.md reference/api-reference.md"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [
          {
            "path": "visualping-api.skill",
            "label": "visualping-api.skill"
          }
        ]
      }
    ]
  ]
}
